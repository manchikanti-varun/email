# MailHealth SMTP Worker — deploy on a host that permits OUTBOUND TCP port 25
# (e.g. a Hetzner/OVH/Contabo VPS). Do NOT deploy on Railway/Vercel/DigitalOcean
# free tiers — they block port 25.

PORT=8090
WORKER_ID=smtp-worker-01
WORKER_REGION=eu

# REQUIRED in production. Must match SMTP_WORKER_SECRET in the main app.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_SECRET=

# SMTP conversation
SMTP_EHLO=mailhealth.verify
SMTP_FROM=verify@yourdomain.com     # use a real domain you control for best acceptance
SMTP_TIMEOUT_MS=10000

# Bounded concurrency / retries / rate limiting
SMTP_WORKER_CONCURRENCY=12
SMTP_MAX_RETRIES=2
WORKER_RATE_LIMIT_PER_MIN=600

NODE_ENV=production
