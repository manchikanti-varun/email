# Copy to .env and adjust as needed
PORT=3000
JWT_SECRET=change-me-in-production

# Email verification tuning
SMTP_ENABLED=true            # set false to skip live SMTP probes (faster, useful behind firewalls)
SMTP_FROM=verify@example.com # MAIL FROM address used in SMTP probe
SMTP_TIMEOUT_MS=8000         # per-connection timeout
VERIFY_CONCURRENCY=5         # parallel verifications for bulk lists

# External verification provider (hybrid architecture). Leave unset to use the
# built-in mock provider (no network, deterministic). Set a key to activate a
# real one; it is only called for locally-inconclusive addresses.
# VERIFY_PROVIDER=zerobounce
# ZEROBOUNCE_API_KEY=your_key_here
# VERIFY_PROVIDER=kickbox
# KICKBOX_API_KEY=your_key_here
PROVIDER_COST_PER_VERIFY=0.004   # used by the benchmark cost estimate
