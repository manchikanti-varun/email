# Copy to .env and adjust as needed
PORT=3000
JWT_SECRET=change-me-in-production

# Webhook signing-secret encryption key (AES-256-GCM), 32 bytes.
# REQUIRED in production. Locally it may be left empty (a key is derived from
# JWT_SECRET for development only). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_ENCRYPTION_KEY=

# Email verification tuning
SMTP_ENABLED=true            # set false to skip live SMTP probes (faster, useful behind firewalls)
SMTP_FROM=verify@example.com # MAIL FROM address used in SMTP probe
SMTP_TIMEOUT_MS=6000         # per-connection timeout (fail blocked port 25 faster)
VERIFY_CONCURRENCY=12        # parallel verifications for bulk lists

# ---- SMTP routing (self-owned worker, NO third-party verification API) -----
# The main app does NOT need outbound port 25. SMTP probing is routed to a
# MailHealth SMTP worker (see smtp-worker/) that runs where port 25 is open.
#   auto     (default) try local port 25, fall back to the worker
#   local    local socket probe only
#   remote   always use the worker
#   disabled no SMTP probing (addresses that pass DNS/MX stay "Unknown")
SMTP_MODE=auto
# Point these at your deployed smtp-worker. Leave empty to run local-only.
SMTP_WORKER_URL=            # e.g. https://smtp.yourdomain.com
SMTP_WORKER_SECRET=         # must match WORKER_SECRET in the worker (>= 24 chars in prod)
SMTP_WORKER_TIMEOUT_MS=12000
SMTP_WORKER_MAX_RETRIES=1

# External verification provider (hybrid architecture). Leave unset to use the
# built-in mock provider (no network, deterministic). Set a key to activate a
# real one; it is only called for locally-inconclusive addresses.
# VERIFY_PROVIDER=zerobounce
# ZEROBOUNCE_API_KEY=your_key_here
# VERIFY_PROVIDER=kickbox
# KICKBOX_API_KEY=your_key_here
PROVIDER_COST_PER_VERIFY=0.004   # used by the benchmark cost estimate

# =====================================================================
# MailHealth AI Agent (optional). The agent is an intelligence layer ON
# TOP of the deterministic verification engine — it never replaces it,
# never fabricates verification results. It is ON by default. With no
# AI_PROVIDER/AI_API_KEY/AI_MODEL set it runs in heuristic (no-LLM) mode:
# deterministic tool selection with no external calls. Set AI_ENABLED=false
# to turn the /api/agent endpoint off entirely.
# =====================================================================
AI_ENABLED=true
# Provider adapter: openai | anthropic | openai-compatible
# Leave AI_PROVIDER empty (with AI_ENABLED=true) to run the agent in
# heuristic mode — deterministic tool selection, no LLM calls.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# AI_BASE_URL=https://api.openai.com/v1   # for openai-compatible gateways

# Runtime safety limits
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2
AI_MAX_ITERATIONS=10           # hard cap on tool iterations per request
AI_RATE_LIMIT_PER_MIN=20       # per-user agent requests / minute

# Cost tracking only (never used for billing)
AI_COST_PER_1K_INPUT=0.00015
AI_COST_PER_1K_OUTPUT=0.0006
AI_CONFIRM_SPEND_THRESHOLD=50  # credits above which the agent shows expected cost
